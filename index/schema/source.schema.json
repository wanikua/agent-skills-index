{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wanikua/agent-skills-index/schemas/source.json",
  "title": "Skill Source",
  "description": "Schema for a skill source repository in the Skill Atlas index",
  "type": "object",
  "required": [
    "id",
    "url",
    "owner_type",
    "tier",
    "status",
    "added_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique source identifier (kebab-case)"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Repository URL"
    },
    "owner_type": {
      "type": "string",
      "enum": ["vendor", "community", "aggregator"],
      "description": "Type of repository owner"
    },
    "tier": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "Source tier: 1=official, 2=community, 3=aggregator"
    },
    "include_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Glob patterns for included paths"
    },
    "exclude_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Glob patterns for excluded paths"
    },
    "policy": {
      "type": "string",
      "description": "Special handling policy"
    },
    "status": {
      "type": "string",
      "enum": ["active", "missing", "archived", "suspended"],
      "description": "Current source status"
    },
    "added_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when source was added"
    },
    "last_crawled_commit": {
      "type": ["string", "null"],
      "description": "Last successfully crawled commit SHA",
      "pattern": "^[0-9a-f]{40}$"
    },
    "last_crawled_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last crawl"
    },
    "verified": {
      "type": "boolean",
      "description": "Whether source has been manually verified"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Internal notes about this source"
    }
  }
}
